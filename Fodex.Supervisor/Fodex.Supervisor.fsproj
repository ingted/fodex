<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PackageId>Fodex.Supervisor</PackageId>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AssemblyName>Fodex.Supervisor</AssemblyName>
    <RootNamespace>Fodex.Supervisor</RootNamespace>
    <LangVersion>preview</LangVersion>
    <WarningsAsErrors>true</WarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Version>0.0.1</Version>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <OutputType>Library</OutputType>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="FodexFunRegistry.fsx" />
    <!-- 舊版依賴已移除的方向 DU；保留來源與 project item，但不與新版 Contract 一起編譯。 -->
    <None Include="ReActJsonV100.fsx">
      <Link>Archive/ReActJsonV100.fsx</Link>
    </None>
    <None Include="ReActDataStoreV100.fsx">
      <Link>Archive/ReActDataStoreV100.fsx</Link>
    </None>
    <Compile Include="ReActJsonV200.fsx" />
    <Compile Include="ReActDataStoreV200.fsx" />
    <Compile Include="SupervisorArgs.fsx" />
    <None Include="IAgentFodexFunV100.fsx">
      <Link>Archive/IAgentFodexFunV100.fsx</Link>
    </None>
    <Compile Include="IAgentFodexFunV200.fsx" />
    <Compile Include="ReActLoopFodexFunV200.fsx" />
    <None Include="ReActLoopFodexFunV100.fsx">
      <Link>Archive/ReActLoopFodexFunV100.fsx</Link>
    </None>
    <None Include="ReActLoopFodexFunV101.fsx">
      <Link>Archive/ReActLoopFodexFunV101.fsx</Link>
    </None>
    <Compile Include="ProcSupervisorV100.fsx" />
    <Compile Include="ProcSupervisorV201.fsx" />
    <Compile Include="CodexAppServerV100.fsx" />
    <Compile Include="NativeAgentV200.fsx" />
    <Compile Include="NativeAgentV201.fsx" />
    <Compile Include="WrapperAgentV200.fsx" />
    <Compile Include="WrapperAgentV201.fsx" />
    <None Include="NativeAgentV100.fsx">
      <Link>Archive/NativeAgentV100.fsx</Link>
    </None>
    <None Include="WrapperAgentV100.fsx">
      <Link>Archive/WrapperAgentV100.fsx</Link>
    </None>
    <Compile Include="CliFodexFunV100.fsx" />
    <Compile Include="FodexFunRegistrationV200.fsx" />
    <Compile Include="FodexFunRegistrationV201.fsx" />
    <Compile Include="WrapperOutputV200.fsx" />
    <Compile Include="WrapperOutputV201.fsx" />
    <None Include="FodexFunRegistrationV100.fsx">
      <Link>Archive/FodexFunRegistrationV100.fsx</Link>
    </None>
    <None Include="FodexFunRegistrationV101.fsx">
      <Link>Archive/FodexFunRegistrationV101.fsx</Link>
    </None>
    <None Include="WrapperOutputV101.fsx">
      <Link>Archive/WrapperOutputV101.fsx</Link>
    </None>
    <None Include="WrapperIAgentDemo.M002.fsx">
      <Link>Archive/WrapperIAgentDemo.M002.fsx</Link>
    </None>
    <None Include="WrapperIAgentDemo.M003.fsx">
      <Link>Archive/WrapperIAgentDemo.M003.fsx</Link>
    </None>
    <None Include="README.V200.md" />
    <None Include="WrapperIAgentDemo.M004.fsx">
      <Link>Archive/WrapperIAgentDemo.M004.fsx</Link>
    </None>
    <None Include="README.M004.md" />
    <None Include="WrapperIAgentDemo.M005.fsx">
      <Link>Archive/WrapperIAgentDemo.M005.fsx</Link>
    </None>
    <None Include="README.M005.md" />
  </ItemGroup>
  <ItemGroup />
  <ItemGroup>
    <ProjectReference Include="..\Fodex.Supervisor.Contract\Fodex.Supervisor.Contracts.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Update="FSharp.Core" Version="10.1.402" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageReference Include="FAkka.Proc.Supervisor" Version="1.572.7-fodex001" />
    <!-- 直接使用既有 transitive 版本的純資料 JSON serializer，明列依賴以避免間接漂移。 -->
    <PackageReference Include="FAkka.FsPickler.Json" Version="10.2.2" />
  </ItemGroup>
</Project>
