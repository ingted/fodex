<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <SelfContained>false</SelfContained>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
	  <TargetFramework>net10.0</TargetFramework>
	  <PackageId>Fodex.Supervisor</PackageId>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AssemblyName>Fodex.Supervisor</AssemblyName>
    <RootNamespace>Fodex.Supervisor</RootNamespace>
    <LangVersion>preview</LangVersion>
    <WarningsAsErrors>true</WarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateTestingPlatformEntryPoint>false</GenerateTestingPlatformEntryPoint>
    <GenerateTestingPlatformConfigurationFile>false</GenerateTestingPlatformConfigurationFile>
    <EnableTestingPlatform>false</EnableTestingPlatform>
    <TestingPlatformDotnetTestSupport>false</TestingPlatformDotnetTestSupport>
    <IsTestProject>false</IsTestProject>
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
    <Version>0.0.1</Version>
    <PackageReadmeFile>README.md</PackageReadmeFile>
	<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PublishProcSupervisorPackage Condition="'$(PublishProcSupervisorPackage)' == ''">false</PublishProcSupervisorPackage>
    <RestoreAdditionalProjectSources>$(RestoreAdditionalProjectSources);$(MSBuildSDKsPath)\..\FSharp\library-packs</RestoreAdditionalProjectSources>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <PropertyGroup>
    <PowerShellExe Condition="'$(OS)' == 'Windows_NT'">powershell</PowerShellExe>
    <PowerShellExe Condition="'$(OS)' != 'Windows_NT'">pwsh</PowerShellExe>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Akka" Version="1.5.73" />
    <PackageReference Include="Akka.Cluster" Version="1.5.73" />
    <PackageReference Include="Akka.Cluster.Sharding" Version="1.5.73" />
    <PackageReference Include="Akka.DistributedData" Version="1.5.73" />
    <PackageReference Include="Akka.Logger.NLog" Version="1.5.69" />
    <PackageReference Include="Akka.Persistence" Version="1.5.73" />
    <PackageReference Include="Akka.Persistence.Sql" Version="1.5.70" />
    <PackageReference Include="Akka.Remote" Version="1.5.73" />
    <PackageReference Include="Akka.Serialization.Hyperion" Version="1.5.73" />
    <PackageReference Include="FAkka.Argu" Version="10.2.1" />
    <PackageReference Include="FAkka.FSharp.Quotations.Evaluator" Version="2.2.1" />
    <PackageReference Include="FAkka.FSI.Supervisor" Version="1.572.2" />
    <PackageReference Include="FSharp.Compiler.Service" Version="43.12.402" />
    <PackageReference Include="FAkka.Quartz.Actor" Version="1.572.2" />
    <PackageReference Include="FAkka.Shared" Version="10.2.6" />
    <PackageReference Include="FAkka.WebSocket" Version="1.572.1" />
    <PackageReference Include="PulseTrade.Comm.Actor.Registry" Version="0.1.8" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageReference Include="FAkka.Fsi.Contracts" Version="10.2.1" />
    <PackageReference Include="MimeKit" Version="4.18.2" />
    <PackageReference Include="Petabridge.Cmd.Common" Version="1.5.2" />
    <PackageReference Include="Petabridge.Cmd.Host" Version="1.5.2" />
    <PackageReference Include="PulseTrade.Infra.Logging" Version="1.572.0" />
  </ItemGroup>
  <ItemGroup>
	  <Compile Include="SupervisorArgs.fsx" />
	  <Compile Include="LoggingRuntime.fsx" />
	  <Compile Include="RegistryFunctionState.fsx" />
	  <Compile Include="Application.fsx" />
	  <Compile Include="main.fsx" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Fodex.Supervisor.Contract\Fodex.Supervisor.Contracts.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Update="FSharp.Core" Version="10.1.402" />
  </ItemGroup>
	<Target Name="PostBuildR" AfterTargets="Pack" Condition="'$(Configuration)' == 'Release' and '$(PublishProcSupervisorPackage)' == 'true'">
		<Exec Command="$(PowerShellExe) -c &quot;write-host '====== Start Post-Build Event ======'&quot;&#xD;&#xA;$(PowerShellExe) ./PostBuildEvent.ps1 Fodex.Supervisor Release" />
	</Target>

	<Target Name="PostBuildD" AfterTargets="Pack" Condition="'$(Configuration)' == 'Debug' and '$(PublishProcSupervisorPackage)' == 'true'">
		<Exec Command="$(PowerShellExe) -c &quot;write-host '====== Start Post-Build Event ======'&quot;&#xD;&#xA;$(PowerShellExe) ./PostBuildEvent.ps1 Fodex.Supervisor Debug" />
	</Target>
	<Target Name="ShowDefineConstants" BeforeTargets="CoreCompile">
		<Message Importance="High" Text="DefineConstants=$(DefineConstants)" />
	</Target>
</Project>
