<?xml version="1.0" encoding="utf-8"?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="false" throwConfigExceptions="true">
  <targets>
    <target name="io" xsi:type="AsyncWrapper" queueLimit="10000" overflowAction="Block" batchSize="256">
      <target xsi:type="File" fileName="${event-properties:item=traceFile}"
              keepFileOpen="true" autoFlush="true" encoding="utf-8"
              layout="${substring:inner=${message}:start=9}" />
    </target>
    <target name="diagnostics" xsi:type="AsyncWrapper" queueLimit="10000" overflowAction="Block" batchSize="256">
      <target xsi:type="File" fileName="${var:lineV4LogDirectory}/diagnostics.${shortdate}.log"
              keepFileOpen="true" autoFlush="true" encoding="utf-8"
              layout="${date:format=o}|${level}|${logger}|${message}${onexception:inner= ${exception:format=tostring}}" />
    </target>
  </targets>
  <rules>
    <logger name="*" minlevel="Info" writeTo="io">
      <filters defaultAction="Log">
        <when condition="not starts-with('${message}', 'FODEX_IO ')" action="Ignore" />
        <when condition="'${event-properties:item=traceFile}' == ''" action="Ignore" />
      </filters>
    </logger>
    <logger name="*" minlevel="Info" writeTo="diagnostics">
      <filters defaultAction="Log">
        <when condition="starts-with('${message}', 'FODEX_IO ') and '${event-properties:item=traceFile}' != ''" action="Ignore" />
      </filters>
    </logger>
  </rules>
</nlog>
