<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <OutputType>Exe</OutputType>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Fodex.Supervisor\DemoOrderHubV100.fsx">
      <Link>DemoOrderHubV100.fsx</Link>
    </Compile>
    <Compile Include="DemoParticipantsV100.fsx" />
    <Compile Include="DemoTraceV100.fsx" />
    <Compile Include="DemoOrderHubV101.fsx" />
    <Compile Include="DemoOrderHubV102.fsx" />
    <Compile Include="DemoOrderHubV103.fsx" />
    <Compile Include="DemoOrderHubV104.fsx" />
    <Compile Include="DemoHubClientV101.fsx" />
    <Compile Include="WrapperTurnTimingV100.fsx" />
    <Compile Include="DemoParticipantsV101.fsx" />
    <Compile Include="DemoParticipantsV102.fsx" />
    <Compile Include="DemoParticipantsV103.fsx" />
    <Compile Include="DemoHostingV100.fsx" />
    <Compile Include="DemoHostingV101.fsx" />
    <Compile Include="DemoHostingV102.fsx" />
    <Compile Include="DemoHostingV103.fsx" />
    <Compile Include="DemoHostingV104.fsx" />
    <Compile Include="DemoHostingV105.fsx" />
    <Compile Include="DemoHostingV106.fsx" />
    <Compile Include="..\Fodex.Supervisor\WrapperIAgentDemo.M011.HubClient.fsx">
      <Link>WrapperIAgentDemo.M011.HubClient.fsx</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="ModelContextProtocol.Core" Version="2.3.0" />
    <PackageReference Include="ModelContextProtocol" Version="2.3.0" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.3.0" />
    <PackageReference Update="FSharp.Core" Version="10.1.402" />
    <ProjectReference Include="..\Fodex.Supervisor\Fodex.Supervisor.fsproj" />
  </ItemGroup>
</Project>
