<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>Fodex.Supervisor.Contracts</PackageId>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AssemblyName>Fodex.Supervisor.Contracts</AssemblyName>
    <RootNamespace>Fodex.Supervisor.Contracts</RootNamespace>
    <LangVersion>preview</LangVersion>
    <WarningsAsErrors>true</WarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Version>0.0.1</Version>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <OutputType>Library</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="LoggerUtil.fsx" />
    <!-- SRTP adapter 由使用專案 Compile/Link；Contract 只提供共同的 UniLogger/UniContext。 -->
    <None Include="LoggerAdapter.fsx" />
    <Compile Include="ParseLine.fsx" />
    <Compile Include="concepts.fsx" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Akka" Version="1.5.73" />
    <PackageReference Include="Akka.Logger.NLog" Version="1.5.69" />
    <PackageReference Include="FAkka.Argu" Version="10.2.1" />
    <PackageReference Include="FAkka.Shared" Version="10.2.6" />
    <PackageReference Include="FAkka.FSharp.Quotations.Evaluator" Version="2.2.1" />
    <PackageReference Include="FSharp.FGL" Version="0.0.4" />
    <PackageReference Include="FSharp.FGL.ArrayAdjacencyGraph" Version="0.0.2" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Update="FSharp.Core" Version="10.1.402" />
  </ItemGroup>
</Project>
