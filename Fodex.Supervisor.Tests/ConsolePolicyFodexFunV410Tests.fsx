#if INTERACTIVE
#load "SharedCacheTestSupport.fsx"
#else
module ConsolePolicyFodexFunV410Tests
#endif
open System
open Expecto
open Fodex.Supervisor
open ImplementationTestSupportV300
open SharedCacheTestSupport

let parseWith (text:string) (argv:string array)=
    FodexFunctions.initialize()
    ConsolePolicyFodexFunV403.pinBase<_,ConsoleStartupV410> "4.1.0" "Console.ParseStartup" (ctx,text,argv)
let parse argv=parseWith ConsolePolicyFodexFunV405.defaults argv
[<Tests>]
let tests=testList "Console policy V410 cache endpoint" [
    testCase "default keeps main AGY sub Codex wrapper and dedicated cache URL" <| fun () ->
        let options,name,url=parse [||] |> required
        Expect.equal (options.GetResult ConsoleArgumentV405.Mainagent_Type) "agy" "main default"
        Expect.equal (options.GetResult ConsoleArgumentV405.Subagent_Type) "codex" "sub default"
        Expect.equal (options.GetResult ConsoleArgumentV405.Subagent_Mode) "wrapper" "sub mode default"
        Expect.isNone name "name still generated by host"
        Expect.equal url.AbsoluteUri "http://127.0.0.1:18825/mcp" "one existing shared cache endpoint"
    testCase "cache port is independent from Akka and main MCP service ports" <| fun () ->
        let options,name,url=parse [|"--mode";"mcp";"--mcpport";"18824";"--akkaport";"21824";"--akkaname";"fdx-test";"--cacheport";"18826"|] |> required
        Expect.equal (options.GetResult ConsoleArgumentV405.Port) 21824 "Akka"
        Expect.equal (options.GetResult ConsoleArgumentV405.Service_Url) "http://127.0.0.1:18824" "wrapper MCP"
        Expect.equal name (Some "fdx-test") "explicit actor name"
        Expect.equal url.AbsoluteUri "http://127.0.0.1:18826/mcp" "cache only"
    testCase "text defaults use PL then Argu and argv overrides cache endpoint" <| fun () ->
        let _,name,url=parseWith (ConsolePolicyFodexFunV405.defaults+"\n--cacheport 18827\n--akkaname from-default") [|"--cache-url";"http://127.0.0.1:18828/mcp"|] |> required
        Expect.equal name (Some "from-default") "default name survives the two existing parser passes"
        Expect.equal url.Port 18828 "explicit URL overrides default cache port"
    testCase "provider override still derives a Codex model instead of retaining AGY defaults" <| fun () ->
        let options,_,_=parse [|"--mainagent-type";"codex"|] |> required
        Expect.equal (options.GetResult ConsoleArgumentV405.Native_Adapter) "app-server" "provider-specific adapter"
        Expect.equal (options.GetResult ConsoleArgumentV405.Model) "gpt-6.1-sol" "provider-specific model"
    testCase "instruction content containing cache flag text is not interpreted as an endpoint" <| fun () ->
        let text="keep --cacheport 19999 as literal text"
        let options,_,url=parse [|"--prompt";text|] |> required
        Expect.equal (options.GetResult ConsoleArgumentV405.Prompt) text "payload preserved by Argu token boundaries"
        Expect.equal url.Port 18825 "no endpoint side effect"
    testCase "invalid port conflicting URL and unsafe endpoint forms are rejected" <| fun () ->
        for argv in [ [|"--cacheport";"0"|];[|"--cacheport";"65536"|];[|"--cacheport";"18825";"--cache-url";"http://127.0.0.1:18826/mcp"|];[|"--cache-url";"not-a-url"|];[|"--cache-url";"http://127.0.0.1:0/mcp"|];[|"--cache-url";"http://u@127.0.0.1:18825/mcp"|];[|"--cache-url";"http://127.0.0.1:18825/mcp?x=1"|] ] do
            Expect.isError (parse argv) "fail before creating ActorSystem/native"
]
#if INTERACTIVE
if runTestsWithCLIArgs [] [||] tests<>0 then failwith "ConsolePolicyFodexFunV410Tests failed"
#endif
