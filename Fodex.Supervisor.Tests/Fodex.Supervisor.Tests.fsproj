<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <OutputType>Exe</OutputType>
    <LangVersion>preview</LangVersion>
    <WarningsAsErrors>true</WarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateProgramFile>false</GenerateProgramFile>
    <IsTestProject>true</IsTestProject>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="ImplementationTestHelpers.fs" />
    <Compile Include="RegistryFunctionQuotationTests.fs" />
    <Compile Include="CodexRuntimeV100Tests.fs" />
    <Compile Include="ProcSupervisorV100Tests.fs" />
    <Compile Include="CliFodexFunV100Tests.fs" />
    <Compile Include="IAgentFodexFunV100Tests.fs" />
    <Compile Include="ReActDataStoreV100Tests.fs" />
    <Compile Include="ReActLoopFodexFunV100Tests.fs" />
    <Compile Include="FodexFunRegistrationV100Tests.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Expecto" Version="11.1.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Fodex.Supervisor.Contract\Fodex.Supervisor.Contracts.fsproj" />
    <ProjectReference Include="..\Fodex.Supervisor\Fodex.Supervisor.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Update="FSharp.Core" Version="10.1.402" />
  </ItemGroup>
</Project>
